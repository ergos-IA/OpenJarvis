# Variables compartidas de Jarvis en el VPS (sustituye a las "Shared
# Variables" de Railway).  Copia a deploy/vps/shared.env y rellena:
#
#   cp deploy/vps/shared.env.example deploy/vps/shared.env
#   chown 10001:10001 deploy/vps/shared.env && chmod 600 deploy/vps/shared.env
#
# - La consola y la web las leen (env_file) y el fichero se monta en
#   /run/jarvis/shared.env (JARVIS_SHARED_ENV).
# - Al crear o recrear una instancia, cada ${{shared.X}} que pone el
#   aprovisionamiento se sustituye por el valor de X de este fichero.
# - Formato KEY=valor, sin espacios alrededor del "=".  Tras cambiar un
#   valor: `dockerctl recreate --all` (las instancias lo recogen) y
#   `docker compose ... up -d` (consola y web).

# Token interno con el que consola y Stripe recargan créditos en una instancia.
FASTTRACK_ADMIN_TOKEN=

# IA incluida en el precio (planes esencial/pro o "IA incluida" en la consola).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Datos legales de la empresa (textos legales de cada Jarvis y de la web).
LEGAL_COMPANY=Fast Factory IA Engine S.L.
LEGAL_NIF=
LEGAL_ADDRESS=
LEGAL_REGISTRY=
LEGAL_EMAIL=hola@aifasttrack.tech
LEGAL_DPO=
LEGAL_JURISDICTION=
LEGAL_HOSTING=Hostinger (VPS en la UE)

# Correo (Mailjet): formulario de contacto, avisos de Stripe y el email de
# acceso que manda cada instancia nueva.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
FROM_EMAIL=no-reply@aifasttrack.tech
CONTACT_TO=hola@aifasttrack.tech

# Opcional: apps OAuth / Microsoft compartidas por todas las instancias.
# Para que cada instancia las reciba, nómbralas en JARVIS_INSTANCE_SHARED
# (control.env), p. ej. JARVIS_INSTANCE_SHARED=MS_CLIENT_ID,MS_TENANT_ID
# MS_CLIENT_ID=
# MS_TENANT_ID=
# OPENJARVIS_GOOGLE_CLIENT_ID=
# OPENJARVIS_GOOGLE_CLIENT_SECRET=
