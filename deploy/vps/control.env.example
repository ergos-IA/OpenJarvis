# Secretos SOLO de la consola y de la web pública (nunca se copian a las
# instancias).  Copia a deploy/vps/control.env y rellena:
#
#   cp deploy/vps/control.env.example deploy/vps/control.env && chmod 600 deploy/vps/control.env

# Consola (https://consola-jarvis.aifasttrack.tech)
ADMIN_PASSWORD=

# Stripe (web pública).  El webhook sigue en
# https://jarvis.aifasttrack.tech/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=

# Opcional
# LANDING_CONTACT_URL=#contacto
# JARVIS_INSTANCE_SHARED=MS_CLIENT_ID,MS_TENANT_ID
# JARVIS_INSTANCE_MEMORY_MB=1024
